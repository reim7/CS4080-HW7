## 4. chunk.c - Updated writeChunk()

This function adds a new byte to the bytecode array. It only creates a new LineStart record when the source line changes.

```c
void writeChunk(Chunk* chunk, uint8_t byte, int line) {
  // Grow the bytecode array if necessary.
  if (chunk->capacity < chunk->count + 1) {
    int oldCapacity = chunk->capacity;
    chunk->capacity = GROW_CAPACITY(oldCapacity);

    chunk->code = GROW_ARRAY(
        uint8_t,
        chunk->code,
        oldCapacity,
        chunk->capacity);
  }

  // Store the new byte.
  chunk->code[chunk->count] = byte;
  chunk->count++;

  // If the source line has not changed,
  // there is no need for another LineStart record.
  if (chunk->lineCount > 0 &&
      chunk->lines[chunk->lineCount - 1].line == line) {
    return;
  }

  // Grow the line information array if necessary.
  if (chunk->lineCapacity < chunk->lineCount + 1) {
    int oldCapacity = chunk->lineCapacity;
    chunk->lineCapacity = GROW_CAPACITY(oldCapacity);

    chunk->lines = GROW_ARRAY(
        LineStart,
        chunk->lines,
        oldCapacity,
        chunk->lineCapacity);
  }

  // Record the beginning of the new source line.
  LineStart* lineStart = &chunk->lines[chunk->lineCount++];

  lineStart->offset = chunk->count - 1;
  lineStart->line = line;
}
```

