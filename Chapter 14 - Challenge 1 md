## 5. chunk.c - Implement getLine()

This function finds the source line associated with a bytecode offset using binary search.

```c
int getLine(Chunk* chunk, int instruction) {
  // Check that the requested offset is valid.
  if (instruction < 0 ||
      instruction >= chunk->count ||
      chunk->lineCount == 0) {
    return -1;
  }

  int start = 0;
  int end = chunk->lineCount - 1;

  while (start <= end) {
    int mid = start + (end - start) / 2;

    LineStart* line = &chunk->lines[mid];

    if (instruction < line->offset) {
      end = mid - 1;
    } else if (
        mid == chunk->lineCount - 1 ||
        instruction < chunk->lines[mid + 1].offset) {
      return line->line;
    } else {
      start = mid + 1;
    }
  }

  return -1;
}
```

